# Eve pricing agent — local env. Copy to .env.
# Model (Eve resolves "anthropic/claude-opus-4-8" via the AI SDK / AI Gateway):
ANTHROPIC_API_KEY=

# Database the tools read via @dip/core loadDatabaseUrl() (first match wins):
#   DATABASE_URL | POSTGRES_URL | SUPABASE_DB_URL | POSTGRES_PRISMA_URL | POSTGRES_URL_NON_POOLING
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dip
