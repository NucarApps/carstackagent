# ---------------------------------------------------------------------------
# Dealership Intelligence Platform — environment template
# Copy to .env.local for local development. NEVER commit real secrets.
# Each service reads only the variables it needs; this file is the union.
# ---------------------------------------------------------------------------

# --- Shared ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Local docker-compose Postgres+PostGIS (see docker-compose.yml).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dip

# --- ingestion ------------------------------------------------------------
CARSTACK_API_BASE=https://carstack.io/api/v1/t/Nucar
# Bearer key. A 403 from an endpoint means that scope is not enabled on this key.
CARSTACK_API_KEY=
# Throttle for the per-VIN /vdp-enrichment endpoint (requests per minute).
VDP_RATE_PER_MIN=240
# Pagination page-size cap enforced by the CarStack client.
PAGE_SIZE_MAX=200
# Optional: pin the snapshot date for a deterministic backfill (YYYY-MM-DD).
INGESTION_SNAPSHOT_DATE=
# Point the ingestion worker at the local mock CarStack server instead:
# CARSTACK_API_BASE=http://localhost:8787/api/v1/t/Nucar
# CARSTACK_API_KEY=dev-mock-key

# --- agents / learning ----------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
AGENT_MAX_TOKENS=16000
# Comma-separated list of agents to run (subset of the registered agents).
AGENTS_ENABLED=stocking,pricing,aged-inventory,lead-conversion,conquest
# How aggressively the weekly learning loop nudges calibration thresholds (0..1).
CALIBRATION_LEARN_RATE=0.25

# --- orchestrator ---------------------------------------------------------
# Open recommendations older than this many days are expired off the worklist.
WORKLIST_EXPIRY_DAYS=14
# Recommendations below this dollar impact are suppressed from the worklist.
MIN_DOLLAR_IMPACT=250

# --- api ------------------------------------------------------------------
PORT=8080
# HS256 secret used to verify Supabase JWTs (dev can use any shared string).
SUPABASE_JWT_SECRET=dev-insecure-jwt-secret
CORS_ORIGIN=http://localhost:5173

# --- web (build-time) -----------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
