{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm db:migrate && pnpm turbo build --filter=@dip/api... --filter=@dip/ingestion...",
  "functions": {
    "api/**/*.ts": { "maxDuration": 300 }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/$1" }],
  "crons": [{ "path": "/api/cron/ingest", "schedule": "0 2 * * *" }]
}
